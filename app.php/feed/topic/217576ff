		<published>2022-04-02T03:01:41</published>
		<id>http://localhost/opengd77/viewtopic.php?t=2175&amp;p=18118#p18118</id>
		<link href="http://localhost/opengd77/viewtopic.php?t=2175&amp;p=18118#p18118"/>
