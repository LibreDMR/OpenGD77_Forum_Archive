		<author><name><![CDATA[TA1ECA]]></name></author>
		<updated>2025-02-01T08:55:08</updated>

		<published>2025-02-01T08:55:08</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4832&amp;p=35525#p35525</id>
		<link href="http://localhost/opengd77/viewtopic.php?t=4832&amp;p=35525#p35525"/>
