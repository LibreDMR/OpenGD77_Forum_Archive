		<author><name><![CDATA[F1RMB]]></name></author>
		<updated>2025-02-28T08:09:17</updated>

		<published>2025-02-28T08:09:17</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4919&amp;p=36000#p36000</id>
		<link href="http://localhost/opengd77/viewtopic.php?t=4919&amp;p=36000#p36000"/>
