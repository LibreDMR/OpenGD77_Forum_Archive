		<author><name><![CDATA[JP7NJT]]></name></author>
		<updated>2024-09-16T17:46:00</updated>

		<published>2024-09-16T17:46:00</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4367&amp;p=32974#p32974</id>
