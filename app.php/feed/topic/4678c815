		<author><name><![CDATA[VK3KYY]]></name></author>
		<updated>2024-12-18T21:14:41</updated>

		<published>2024-12-18T21:14:41</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4678&amp;p=34774#p34774</id>
