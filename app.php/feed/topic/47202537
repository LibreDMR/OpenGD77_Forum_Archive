		<published>2024-12-30T21:50:43</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4720&amp;p=34958#p34958</id>
		<link href="http://localhost/opengd77/viewtopic.php?t=4720&amp;p=34958#p34958"/>
