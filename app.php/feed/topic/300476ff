		<author><name><![CDATA[LU2BAM]]></name></author>
		<updated>2023-07-04T15:02:20</updated>

		<published>2023-07-04T15:02:20</published>
		<id>http://localhost/opengd77/viewtopic.php?t=3004&amp;p=24215#p24215</id>
		<link href="http://localhost/opengd77/viewtopic.php?t=3004&amp;p=24215#p24215"/>
