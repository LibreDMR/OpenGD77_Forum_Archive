		<author><name><![CDATA[K4URO]]></name></author>
		<updated>2024-10-10T13:08:17</updated>

		<published>2024-10-10T13:08:17</published>
		<id>http://localhost/opengd77/viewtopic.php?t=2035&amp;p=33420#p33420</id>
