		<author><name><![CDATA[ve2wkr]]></name></author>
		<updated>2022-10-20T05:20:08</updated>

		<published>2022-10-20T05:20:08</published>
		<id>http://localhost/opengd77/viewtopic.php?t=2375&amp;p=20197#p20197</id>
