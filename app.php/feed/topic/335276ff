		<author><name><![CDATA[VK3KYY]]></name></author>
		<updated>2024-11-03T19:11:37</updated>

		<published>2024-11-03T19:11:37</published>
		<id>http://localhost/opengd77/viewtopic.php?t=3352&amp;p=33899#p33899</id>
