		<author><name><![CDATA[UT7UX]]></name></author>
		<updated>2024-10-01T18:35:13</updated>

		<published>2024-10-01T18:35:13</published>
		<id>http://localhost/opengd77/viewtopic.php?t=4103&amp;p=33319#p33319</id>
